# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead.

# Your OpenAI API key — used server-side only (in pages/api/generate-plan.js),
# never exposed to the browser. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# The Google Apps Script "Web App" URL from your deployed lead-capture sheet.
# See scripts/google-apps-script.gs and README.md for setup steps.
GOOGLE_SHEET_WEBHOOK_URL=
